{
  "name": "dsh-subagent-antigravity",
  "description": "One-shot Antigravity CLI subagent provider over the official headless stream-json protocol",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ring1003/dsh-subagent-antigravity.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test:smoke": "tsx test/smoke.ts"
  },
  "license": "MIT",
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1",
    "@deepseek-ai/dsh-tool-subagent": "0.2.1-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.2",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
